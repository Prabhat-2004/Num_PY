   "outputs": [],
   "source": [
    "# Array Stacking & Spliting\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "3088fff0",
   "metadata": {},
   "outputs": [],
   "source": [
    "arr1 = np.array([1,2,3,4])\n",
    "arr2 = np.array([5,6,7,8])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "82fade48",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[[1 2 3 4]\n",
      " [5 6 7 8]]\n"
     ]
    }
   ],
   "source": [
    "print(np.vstack((arr1,arr2))) # Verticaly Stacking - Row Wise"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "36f0168f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[1 2 3 4 5 6 7 8]\n"
     ]
    }
   ],
   "source": [
    "print(np.hstack((arr1,arr2))) # Horizontal Stacking - column wise"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ee1498ae",
